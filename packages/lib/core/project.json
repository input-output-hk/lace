{
  "projectType": "library",
  "tags": ["scope:lib"],
  "targets": {
    "lint": {},
    "type-check-src": {},
    "type-check-test": {},
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config=vitest.config.js --coverage",
        "cwd": "{projectRoot}"
      }
    },
    "test-watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest watch --config=vitest.config.js --coverage",
        "cwd": "{projectRoot}"
      }
    },
    "test-perf": {
      "executor": "nx:run-commands",
      "options": {
        "command": "TEST_RUNNER_PATH=../../../node_modules/.bin/jest TEST_RUNNER_ARGS='--config jest.perf.config.js --runInBand --forceExit' ../../../node_modules/.bin/reassure",
        "cwd": "{projectRoot}"
      }
    }
  }
}
