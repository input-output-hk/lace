# E2E build flavor (hermetic) — consumed by `npm run build:e2e` via
# scripts/run-with-env.ts. Every backend URL points at the local mock backend
# (apps/lace-extension-e2e-v2/src/mock-backend) so the built extension makes
# zero external network calls at runtime.
#
# These values take precedence over webpack/.env + webpack/.env.defaults:
# - webpack legs: dotenv-webpack runs with `systemvars: true`
# - expo leg: scripts/prepare-expo-env.ts gives shell env precedence for keys
#   declared in .env.defaults / .env.example
#
# PORT CONSTRAINT: the mock server MUST listen on localhost:3001 — the dev
# manifest CSP (webpack/webpack-utils.js $LOCALHOST_CONNECT_SRC) only admits
# localhost ports 3000/3001/8080.
#
# POSTHOG_API_URL must NEVER point at the mock: a successful remote
# feature-flag fetch arms reloadAppInTheBackground, and runtime.reload()
# permanently disables a --load-extension extension (see the baseline's
# wdio.chrome.conf.ts host-resolver note). It used to inherit a real host from
# webpack/.env.defaults, but main PR #2579 blanked that default, so it is set
# here to a reserved-TLD host (.invalid, RFC 2606) that can never resolve —
# the fetch fails deterministically even without the blackhole.

POSTHOG_API_URL=https://posthog.e2e.invalid

# PR #2579 on main renamed BLOCKFROST_URL_{MAINNET,PREPROD,PREVIEW} to a single
# BLOCKFROST_PROXY_URL (key is injected server-side). The branch now sits on a
# post-#2579 base, so only the new spelling exists here.
BLOCKFROST_PROXY_URL=http://localhost:3001/blockfrost
BLOCKFROST_IPFS_URL=http://localhost:3001/ipfs
CARDANO_SERVICES_URL_MAINNET=http://localhost:3001/cardano-services/mainnet
CARDANO_SERVICES_URL_PREPROD=http://localhost:3001/cardano-services/preprod
CARDANO_SERVICES_URL_PREVIEW=http://localhost:3001/cardano-services/preview
COINGECKO_API_BASE_URL=http://localhost:3001/coingecko/api/v3
MAESTRO_URL_MAINNET=http://localhost:3001/maestro/mainnet
MAESTRO_URL_TESTNET=http://localhost:3001/maestro/testnet
# Placeholders: declared in .env.example (dotenv-webpack `safe:` requires them,
# normally CI secrets / a developer webpack/.env). The mock never checks keys.
MAESTRO_PROJECT_ID_MAINNET=e2e-mock-project-id
MAESTRO_PROJECT_ID_TESTNET=e2e-mock-project-id
MEMPOOLSPACE_URL_MAINNET=http://localhost:3001/mempoolspace
MEMPOOLSPACE_URL_TESTNET=http://localhost:3001/mempoolspace/testnet4
NFT_CDN_URL=http://localhost:3001/nftcdn
CARDANO_CUBE_BASE_URL=http://localhost:3001/cardano-cube
STEELSWAP_API_BASE_URL=http://localhost:3001/steelswap
