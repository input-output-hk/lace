{
  "projectType": "library",
  "tags": ["scope:lib"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        {
          "externalDependencies": ["typescript"]
        }
      ],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "tsc -p tsconfig.build.json",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {},
    "type-check-src": {}
  }
}
