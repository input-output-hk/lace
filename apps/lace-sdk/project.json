{
  "name": "lace-sdk",
  "projectType": "library",
  "tags": ["scope:app", "release:lace-sdk"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/build.sh",
        "cwd": "apps/lace-sdk"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/packages/contract/*/src/**/*",
        "{workspaceRoot}/packages/lib/*/src/**/*",
        "{workspaceRoot}/packages/module/*/src/**/*",
        "{workspaceRoot}/tsconfig.base.json",
        {
          "dependentTasksOutputFiles": "**/*.{js,cjs,d.ts,json}",
          "transitive": true
        },
        {
          "env": "SDK_CHANNEL"
        }
      ],
      "outputs": ["{projectRoot}/dist", "{projectRoot}/dist-canary"]
    },
    "check-doc-comments": {
      "executor": "nx:run-commands",
      "options": {
        "command": "SDK_CHANNEL=stable node test/check-doc-comments.mjs && SDK_CHANNEL=canary node test/check-doc-comments.mjs",
        "cwd": "{projectRoot}"
      }
    },
    "type-check-src": {},
    "type-check-test": {},
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config=vitest.config.js --coverage && node test/check-stable-variants.mjs",
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "default",
        "^default",
        "sharedGlobals",
        "{workspaceRoot}/.github/workflows/sdk-release-version.yml",
        "{workspaceRoot}/.github/workflows/sdk-release.yml"
      ]
    },
    "lint": {}
  }
}
